# Sign-in is ON by default. If no accounts exist on first start, an admin is
# seeded from the two variables below; if the password is unset, a random
# one-time password is generated and printed ONCE in the server log.
ATHENA_AUTH_ENABLED=true
ATHENA_ADMIN_USER=admin
ATHENA_ADMIN_PASSWORD=change-me-strong-password

# Self-service registration at /signup (always creates non-admin accounts).
ATHENA_ALLOW_SIGNUP=true
ATHENA_SIGNUP_ROLE=viewer

# Machine-to-machine key for SIEM/SOAR automation (admin-level, skips CSRF).
# generate with: openssl rand -hex 32
ATHENA_API_KEY=change-me-to-a-32-byte-hex-secret

ATHENA_ORG=Your Organization

# Optional integrations (uncomment and fill):
# ATHENA_SPLUNK_HEC_URL=https://splunk:8088/services/collector
# ATHENA_SPLUNK_HEC_TOKEN=
# ATHENA_SLACK_WEBHOOK=
# ATHENA_SYSLOG_HOST=
